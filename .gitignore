# Secrets / env files
.env
.env.*
*.pem
*.key
credentials.json

# npm (not used here, but harmless)
node_modules/
package-lock.json

# Scratch
local/
tmp/

# Private maintenance notes (kept off the public repo)
MAINTAIN.md

# Paper-thumbnail builder cache
scripts/.cache/

# Python bytecode (created when scripts/ modules are imported)
__pycache__/
*.py[cod]
